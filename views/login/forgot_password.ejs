<div class="container-fluid page-body-wrapper full-page-wrapper">
    <div class="content-wrapper d-flex align-items-center auth px-0">
      <div class="row w-100 mx-0">

        <div class="col-lg-4 mx-auto">
          <div class="auth-form-light text-left loginWrapper">
            <div class="brand-logo brand_logo_cus">
              <img src="/images/logo.png" alt="logo" style="width: 75px !important;height: auto; ">
            </div>
            <h4>Welcome to Commission Office </h4>
            <form id="resetForm" autocomplete="off">
                    <div class="form-group">
                        <label>User Name <span class="red">*</span></label>

                        <div class="input-group">
                            <input type="text"
                                  class="form-control"
                                  id="user_id"
                                  placeholder="Username"
                                  required>

                            <button type="button"
                                    class="btn btn-primary"
                                    id="generateOtpBtn">
                                Generate OTP
                            </button>
                        </div>
                    </div>

                    <!-- OTP SECTION -->

                    <div class="form-group mt-3" id="otpSection" style="display:none;">
                        <label>Enter OTP <span class="red">*</span></label>

                        <div class="input-group">
                            <input type="text"
                                  class="form-control"
                                  maxlength="4"
                                  id="otp"
                                  placeholder="4 Digit OTP">

                            <button type="button"
                                    class="btn btn-success"
                                    id="verifyOtpBtn">
                                Verify OTP
                            </button>
                        </div>
                    </div>

                    <!-- PASSWORD SECTION -->

                    <div id="passwordSection" style="display:none;">

                        <div class="form-group mt-3">
                            <label>New Password</label>
                            <input type="password"
                                  class="form-control"
                                  id="newPass">
                        </div>

                        <div class="form-group mt-3">
                            <label>Confirm Password</label>
                            <input type="password"
                                  class="form-control"
                                  id="confirmPass">
                        </div>

                        <div class="mt-3">
                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Reset Password
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="auth-form-light text-left loginWrapper">
<ul>
                <li id="lowercase" class="cross">At least one lowercase letter</li>
                <li id="uppercase" class="cross">At least one uppercase letter</li>
                <li id="number" class="cross">At least one number</li>
                <li id="special" class="cross">At least one special character</li>
                <li id="length" class="cross">Minimum length of 8 characters</li>
              </ul>
            </div>
          </div>
         
      </div>
    </div>
  </div>

<script>

let otpVerified = false;

/* Generate OTP */
let otpCooldownTimer;
document.getElementById('generateOtpBtn')
.addEventListener('click', async () => {

    const user_id = document.getElementById('user_id').value;
   
    if(!user_id){
        alert('Enter User ID');
        return;
    }

      try {

        const response = await fetch('/login/generate-otp', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                user_id
            })
        });

        const result = await response.json();

        if (result.suc === 1) {

            alert(result.msg);

            document.getElementById('otpSection').style.display = 'block';
            startOtpCooldown();

        } else {

            alert(result.msg || 'OTP sending failed');

        }

      } catch (err) {

          console.error(err);

          alert('Server error. Please try again.');

      }
});

function startOtpCooldown() {

    const btn = document.getElementById('generateOtpBtn');

    let timeLeft = 600; // 10 minutes = 600 seconds

    btn.disabled = true;

    otpCooldownTimer = setInterval(() => {

        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;

        btn.textContent = `Resend in ${minutes}:${seconds
            .toString()
            .padStart(2, '0')}`;

        timeLeft--;

        if (timeLeft < 0) {

            clearInterval(otpCooldownTimer);

            btn.disabled = false;
            btn.textContent = 'Resend OTP';

        }

    }, 1000);
}
/* Verify OTP */

document.getElementById('verifyOtpBtn')
.addEventListener('click', async () => {

    const user_id = document.getElementById('user_id').value;
    const otp = document.getElementById('otp').value;

    if(!otp){
        alert('Enter OTP');
        return;
    }

    const response = await fetch('/login/verify-otp', {
        method:'POST',
        headers:{
            'Content-Type':'application/json'
        },
        body:JSON.stringify({
            user_id,
            otp
        })
    });

    const result = await response.json();

    if(result.success){

        otpVerified = true;

        alert('OTP Verified');

        document.getElementById('passwordSection')
        .style.display='block';

        document.getElementById('verifyOtpBtn').disabled=true;

    }else{
        alert(result.message);
    }

});


/* Reset Password */

document.getElementById('resetForm')
.addEventListener('submit', async (e)=>{

    e.preventDefault();

    if(!otpVerified){
        alert('Verify OTP First');
        return;
    }

    const user_id = document.getElementById('user_id').value;
    const otp = document.getElementById('otp').value;
    const password = document.getElementById('newPass').value;
    const confirmPassword = document.getElementById('confirmPass').value;

    if(password !== confirmPassword){
        alert('Password Mismatch');
        return;
    }

    const response = await fetch('/reset-password', {
        method:'POST',
        headers:{
            'Content-Type':'application/json'
        },
        body:JSON.stringify({
            user_id,
            otp,
            password
        })
    });

    const result = await response.json();

    if(result.success){

        alert('Password Changed Successfully');

        window.location.href='/login';

    }else{

        alert(result.message);

    }

});

</script>